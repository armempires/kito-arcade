# Variáveis de Ambiente para o Kito Arcade
# Copie este arquivo para .env e preencha com suas credenciais

# Supabase - Obtenha em: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-do-supabase

# Opcional - Para analytics ou outras integrações futuras
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx